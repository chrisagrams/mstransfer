# --- Benchmark mode ---
# "per-file" = time each file individually, "batch" = time all files as one batch
BENCHMARK_MODE=per-file

# --- mstransfer ---
MSTRANSFER_HOST=http://localhost:1319
MSTRANSFER_API_KEY=              # optional, leave blank if no auth

# --- SFTP ---
SFTP_HOST=example.com
SFTP_PORT=22
SFTP_USER=username
SFTP_KEY_PATH=~/.ssh/id_rsa     # path to private key
SFTP_DEST_DIR=/upload            # remote directory

# --- S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=                 # custom endpoint for MinIO, etc. (e.g. http://localhost:9000)
S3_BUCKET=my-bucket
S3_PREFIX=benchmark/             # optional prefix/folder in bucket
